# ============================================
# AUTO-P / AutoIntel - Production Environment
# ============================================
# IMPORTANT: Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to version control

# ============================================
# Django Configuration
# ============================================
SECRET_KEY=GENERATE_WITH_python_-c_"import_secrets;_print(secrets.token_hex(32))"
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# If using Railway/Heroku, DATABASE_URL will be auto-injected
# Otherwise, configure manually:
DB_NAME=autointel_production
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_HOST=your-db-host.com
DB_PORT=5432
DATABASE_URL=postgresql://postgres:CHANGE_THIS_STRONG_PASSWORD@your-db-host.com:5432/autointel_production

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# ============================================
# Stripe Payment Configuration
# ============================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_live_YOUR_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ============================================
# AI/LLM Configuration (Optional)
# ============================================
# For AI assistant features
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE

# ============================================
# Notification Services (Optional)
# ============================================
# Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=AC_YOUR_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email Configuration (SMTP)
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=YOUR_EMAIL_PASSWORD

# ============================================
# Security & Monitoring (Optional)
# ============================================
# Sentry for error tracking
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID

# Google Analytics
GA_MEASUREMENT_ID=G-YOUR_GA_ID

# ============================================
# Redis Configuration (Optional - for Celery)
# ============================================
REDIS_URL=redis://your-redis-host:6379/0

# ============================================
# Deployment-Specific
# ============================================
# Railway/Vercel will inject these automatically
# RAILWAY_ENVIRONMENT=production
# VERCEL_ENV=production
